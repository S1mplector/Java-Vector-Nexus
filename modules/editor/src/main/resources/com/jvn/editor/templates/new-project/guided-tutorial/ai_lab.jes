scene "Follow behavior" {
  tileset "paper_tiles" { image: "assets/tutorial/labs/tiles.png" tileW: 16 tileH: 16 cols: 2 }
  // region map
  map "workshop" {
    tileset: "paper_tiles" width: 10 height: 8 tileW: 48 tileH: 48
    layer "floor" { data: "assets/tutorial/labs/floor.csv" }
    layer "walls" { data: "assets/tutorial/labs/walls.csv" collision: true }
  }
  // endregion
  entity "hero" {
    component Character2D {
      spriteSheet: "assets/tutorial/labs/player.png" frameW: 16 frameH: 16 cols: 1
      drawW: 32 drawH: 32 startTileX: 2 startTileY: 3 speed: 110 controllable: true
      animations: "down:0-0,up:0-0,left:0-0,right:0-0" startAnim: "down"
    }
  }
  // region ai
  entity "follower" {
    component Character2D {
      spriteSheet: "assets/tutorial/labs/npc.png" frameW: 16 frameH: 16 cols: 1
      drawW: 32 drawH: 32 startTileX: 7 startTileY: 3 speed: 75
      animations: "down:0-0,up:0-0,left:0-0,right:0-0" startAnim: "down"
    }
    component Ai2D { type: "chase" target: "hero" aggroRange: 0 attackRange: 34 moveSpeed: 75 }
  }
  // endregion
  entity "hint" {
    component Label2D { text: "Arrow keys move the green marker. Watch the follower. Esc returns." x: 15 y: 420 size: 21 }
  }
  on key "LEFT" do moveHero { dir: "left" }
  on key "RIGHT" do moveHero { dir: "right" }
  on key "UP" do moveHero { dir: "up" }
  on key "DOWN" do moveHero { dir: "down" }
  on key "D" do toggleDebug
  on key "ENTER" do return
  on key "ESCAPE" do return
}
