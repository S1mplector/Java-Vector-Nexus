id=tutorial_card
title=Workshop card
x=0.22
y=0.10
width=0.56
height=0.52
modal=true
dim=true
dismiss=false
call=true
returnKey=screen.return.tutorial_card
nodes=name,energy_label,energy,hint
node.name.type=text
node.name.text=${workshop_name}
node.name.x=0.08
node.name.y=0.18
node.name.width=0.84
node.name.height=0.12
node.energy_label.type=text
node.energy_label.text=Workshop energy
node.energy_label.x=0.08
node.energy_label.y=0.36
node.energy_label.width=0.84
node.energy_label.height=0.10
node.energy.type=bar
node.energy.value=${workshop_energy}
node.energy.x=0.08
node.energy.y=0.50
node.energy.width=0.84
node.energy.height=0.10
node.hint.type=text
node.hint.text=Recharge before continuing.
node.hint.visibleIf=workshop_energy < 0.50
node.hint.x=0.08
node.hint.y=0.65
node.hint.width=0.84
node.hint.height=0.10
buttons=continue,close
button.continue.label=Continue
button.continue.action=return
button.continue.target=continue
button.continue.enabledIf=workshop_energy >= 0.50
button.close.label=Close
button.close.action=return
button.close.target=close
