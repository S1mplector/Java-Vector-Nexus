scene "Physics restitution" {
  entity "hint" {
    component Label2D { text: "Compare the two moving circles. Enter or Esc: return." x: 25 y: 32 size: 22 }
  }
  // region restitution
  entity "soft" {
    component PhysicsBody2D { shape: circle x: 110 y: 150 r: 22 vx: 200 vy: 0 restitution: 0.1 color: rgb(0.55,0.30,0.18,1) }
  }
  entity "bouncy" {
    component PhysicsBody2D { shape: circle x: 110 y: 240 r: 22 vx: 200 vy: 0 restitution: 1.0 color: rgb(0.24,0.49,0.47,1) }
  }
  entity "wall" {
    component PhysicsBody2D { shape: box x: 410 y: 80 w: 32 h: 300 static: true restitution: 1.0 color: rgb(0.42,0.42,0.42,1) }
  }
  // endregion
  on key "D" do toggleDebug
  on key "ENTER" do return
  on key "ESCAPE" do return
}
