scene "PanelExample" {
  entity "room" {
    component Sprite2D { image: "assets/tutorial/white.png" x: 0 y: 0 w: 1920 h: 1080 }
  }
  entity "panel" {
    component Panel2D { x: 110 y: 110 w: 790 h: 235 fill: rgb(0.12, 0.24, 0.22, 1) }
  }
// region indicator
  entity "indicator" {
    component Panel2D {
      x: 840 y: 138
      w: 28 h: 28
      fill: rgb(1, 0.65, 0.48, 1)
    }
  }
// endregion
  entity "title" {
    component Label2D { text: "JES panel example" x: 148 y: 168 size: 52 bold: true color: rgb(1, 0.96, 0.88, 1) }
  }
  entity "hint" {
    component Label2D { text: "Press Enter or Esc to return to the lesson." x: 148 y: 252 size: 29 color: rgb(1, 0.96, 0.88, 1) }
  }
// region input
  on key "ENTER" do return
  on key "ESCAPE" do return
// endregion
}
