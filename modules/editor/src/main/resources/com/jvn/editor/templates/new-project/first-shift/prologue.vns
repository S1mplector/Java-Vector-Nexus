@scenario first_shift
@include /definitions/characters.vns
@label start
[bg office]
[char pip global on]
[set ui.dialogueFadeMs 160]
[if tutorial_still]
[show pip desk wave]
[else]
[show pip doorway wave]
[move pip doorway stride-a-right exprdur=0]
[move pip desk ease_out_cubic 520]
[wait 130]
[move pip desk stride-b-right exprdur=0]
[wait 130]
[move pip desk stride-c-right exprdur=0]
[wait 130]
[move pip desk stride-b-right exprdur=0]
[wait 130]
[move pip desk wave exprdur=90]
[endif]
pip: Morning! I'm Pip. Grab the spare chair. We've got a tiny game to make before the office closes.
[show pip desk notes]
pip: You can pick a lesson from the project board or help me welcome our newest teammate.
> Open the project board -> route_tutorial
> Welcome the new teammate -> route_branch
@label route_tutorial
[goto TutorialHub:start]
@label route_branch
[goto BranchDemo:start]
