scene "Circle footprint" {
  // region footprint
  entity "footprint" {
    component PhysicsBody2D {
      shape: circle
      x: 50 y: 50 r: 50
      static: true
    }
  }
  // endregion
  entity "hint" {
    component Label2D { text: "D: show collision shapes. Enter or Esc: return." x: 45 y: 180 size: 25 }
  }
  on key "D" do toggleDebug
  on key "ENTER" do return
  on key "ESCAPE" do return
}
